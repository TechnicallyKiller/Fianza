{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Fianza",
  "description": "Revenue-underwritten, uncollateralized USDC credit for AI agents on Stellar.",
  "colors": {
    "primary": "#FFB020",
    "light": "#FFC24D",
    "dark": "#FFB020"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#F4F1E9",
      "dark": "#0B0F0E"
    }
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "what-and-why",
          "architecture"
        ]
      },
      {
        "group": "Protocol",
        "pages": [
          "credit-engine",
          "scoring-methodology",
          "sybil-model"
        ]
      },
      {
        "group": "Build with Fianza",
        "pages": [
          "onboarding-kit",
          "sdk-reference",
          "sdk-reference-python",
          "contracts"
        ]
      },
      {
        "group": "Project",
        "pages": [
          "roadmap"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/TechnicallyKiller/TrustLine"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Live app",
      "href": "https://fianza.space"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/TechnicallyKiller/TrustLine",
      "website": "https://fianza.space"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  }
}
