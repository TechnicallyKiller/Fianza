# TrustLine backend (underwriting engine) — copy to .env, never commit the real one.

# ---- Stellar / Soroban testnet ----
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ---- Deployed contract IDs (from contracts/.env after Phase 1/4) ----
SCORE_REGISTRY_CONTRACT_ID=
CREDIT_LINE_CONTRACT_ID=
LENDING_VAULT_CONTRACT_ID=
USDC_SAC_CONTRACT_ID=

# ---- x402 settlement (OZ Channels facilitator) ----
# GOTCHA: the Stellar x402 quickstart REQUIRES an API key; the server will not
# boot without it.
OZ_API_KEY=
FACILITATOR_URL=

# GOTCHA: the facilitator submitter + fee-payer addresses must be excluded so
# they are never miscounted as an x402 payer (they appear only in `fee` events).
# Comma-separated G... addresses.
X402_EXCLUDE_ADDRESSES=

# ---- Reclaim zkTLS ----
# GOTCHA: API keys go in zkFetch PRIVATE options only, never public options.
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_VERIFIER_CONTRACT_ID=
# Off-chain revenue source (e.g. Stripe) credentials used only in private options
REVENUE_API_KEY=

# ---- Trusted signer (single signer for the MVP) ----
# Secret seed (S...) of the key that signs scores submitted to score_registry.
SCORE_SIGNER_SECRET=

# ---- Tael revenue indexing (seller-side underwriting) ----
# Tael's testnet USDC issuer (classic asset, NOT a SAC contract id) — set once
# confirmed against rahulsainlll/tael-protocol's testnet deployment. Unset ==
# Tael revenue is skipped (best-effort, never breaks underwriting).
TAEL_USDC_ISSUER=
# Stellar text memo Tael stamps on every settlement. Defaults to "tael"
# (packages/stellar/src/pay.ts: TAEL_MEMO) — only override if their convention changes.
TAEL_MEMO=

# ---- API server ----
PORT=8787
HOST=0.0.0.0
