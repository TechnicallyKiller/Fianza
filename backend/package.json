{
  "name": "trustline-backend",
  "version": "0.1.0",
  "private": true,
  "description": "TrustLine off-chain underwriting engine: x402 revenue indexer, Reclaim proof orchestrator, score engine, signer, REST API.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "download-zk-files": "node node_modules/@reclaimprotocol/zk-symmetric-crypto/lib/scripts/download-files"
  },
  "dependencies": {
    "@ethersproject/keccak256": "^5.8.0",
    "@fastify/cors": "^10.0.1",
    "@reclaimprotocol/js-sdk": "^4.3.1",
    "@reclaimprotocol/zk-fetch": "^0.8.0",
    "@stellar/stellar-sdk": "^16.0.1",
    "@x402/core": "^2.17.0",
    "@x402/fetch": "^2.17.0",
    "@x402/stellar": "^2.17.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
    "stellar-hd-wallet": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
