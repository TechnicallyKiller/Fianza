# Soroban / Stellar testnet — contracts package
# Copy to .env and fill in. NEVER commit the real .env.

# Network
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
FRIENDBOT_URL=https://friendbot.stellar.org

# Deployer identity (stellar keys). Name of the funded testnet key, not a secret.
STELLAR_DEPLOYER_KEY=trustline-deployer

# Deployed contract IDs (populated after Phase 1 / Phase 4 deploys)
SCORE_REGISTRY_CONTRACT_ID=
CREDIT_LINE_CONTRACT_ID=
LENDING_VAULT_CONTRACT_ID=

# SEP-41 USDC (testnet) Stellar Asset Contract ID
USDC_SAC_CONTRACT_ID=
