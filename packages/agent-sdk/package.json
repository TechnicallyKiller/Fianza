{
  "name": "@trustline/agent-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for AI agents to take and repay revenue-underwritten credit on TrustLine (Stellar). Settles in USDC.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["stellar", "soroban", "x402", "ai-agents", "credit", "usdc"],
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.1",
    "@x402/fetch": "^2.17.0",
    "@x402/stellar": "^2.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
