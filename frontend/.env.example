# TrustLine frontend — copy to .env.local. Only NEXT_PUBLIC_* vars reach the browser.

# Backend (Phase 2 underwriting API)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Stellar testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployed contract IDs (public; safe to expose)
NEXT_PUBLIC_SCORE_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_CREDIT_LINE_CONTRACT_ID=
NEXT_PUBLIC_LENDING_VAULT_CONTRACT_ID=
NEXT_PUBLIC_USDC_SAC_CONTRACT_ID=
